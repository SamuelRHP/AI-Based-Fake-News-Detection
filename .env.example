# Environment Configuration Template
# Duplicate this file to .env for local development

# Environment & Debug
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Application Security
SECRET_KEY=change-this-in-production-to-a-secure-random-key
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fakenews_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fakenews_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fake-news-detection

# Model & Decision Thresholds
MODEL_TYPE=baseline # options: baseline, transformer
MODEL_ARTIFACTS_DIR=artifacts/models
FAKE_THRESHOLD_HIGH=0.70
FAKE_THRESHOLD_LOW=0.30

# Web Scraping Configuration
REQUEST_TIMEOUT_SECONDS=10
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) FakeNewsDetectorBot/1.0"

